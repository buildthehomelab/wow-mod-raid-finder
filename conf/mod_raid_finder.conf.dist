[worldserver]

########################################
# mod-raid-finder
########################################
#
#    RaidFinder.Enable
#        Description: Master switch for the Raid Finder tab in the Raid Browser (/lfr,
#                     addon/RaidFinder). This is a menu and gathering flow for the existing Normal
#                     raids, not a new difficulty.
#        Default:     0 - (Off)
#                     1 - (On)

RaidFinder.Enable = 0

#
#    RaidFinder.<raid>
#        Description: Offer that raid in the Raid Finder. Every raid is on by default; a character
#                     only sees the raids Individual Progression and their level let them enter.
#                     The ids: zg, aq20, mc, ony40, bwl, aq40, naxx40 (Classic, level 60; ony40
#                     and naxx40 only up to level 70), kara, za, gruul, mag, ssc, tk, hyjal, bt,
#                     swp (Burning Crusade, level 70), and naxx, os, eoe, voa, ony, uld, toc, icc,
#                     rs with 10 or 25 appended (Lich King, level 80).
#        Default:     1 - (On)
#                     0 - (Off)
#        Example:     RaidFinder.icc25 = 0

#
#    RaidFinder.<raid>.MeetingStoneSpawn
#        Description: Gameobject spawn GUID (not the template entry) of the outdoor meeting stone
#                     the raid gathers at. The defaults are the realm's stock stones (427 at the
#                     Blackrock Depths approach for MC, 428 at the Blackrock Spire approach for
#                     BWL, and so on). 0 gathers at the raid's exit instead, where you land when
#                     you leave it (the default for toc and icc, which have no stone). Missing
#                     spawns, objects that aren't meeting stones and points inside an instance
#                     are refused; the finder never teleports into the raid instead.
#        Example:     RaidFinder.mc.MeetingStoneSpawn = 427

#
#    RaidFinder.SummonNeedsLegacyPerk
#        Description: With mod-legacy installed and enabled, Summon to Stone needs the Legacy
#                     perk Summoning Stone (Adventure). Without it a player travels to the meeting
#                     stone themselves; Gather Bots there still brings their drafted bots.
#        Default:     1 - (Perk needed)
#                     0 - (Free for everyone)

RaidFinder.SummonNeedsLegacyPerk = 1
